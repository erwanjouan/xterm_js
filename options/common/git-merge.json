[
  {
    "flags": "-n",
    "description": "do not show a diffstat at the end of the merge"
  },
  {
    "flags": "--stat",
    "description": "show a diffstat at the end of the merge"
  },
  {
    "flags": "--summary",
    "description": "(synonym to --stat)"
  },
  {
    "flags": "--log[=<n>]",
    "description": "add (at most <n>) entries from shortlog to merge commit message"
  },
  {
    "flags": "--squash",
    "description": "create a single commit instead of doing a merge"
  },
  {
    "flags": "--commit",
    "description": "perform a commit if the merge succeeds (default)"
  },
  {
    "flags": "-e, --edit",
    "description": "edit message before committing"
  },
  {
    "flags": "--cleanup <mode>",
    "description": "how to strip spaces and #comments from message"
  },
  {
    "flags": "--ff",
    "description": "allow fast-forward (default)"
  },
  {
    "flags": "--ff-only",
    "description": "abort if fast-forward is not possible"
  },
  {
    "flags": "--rerere-autoupdate",
    "description": "update the index with reused conflict resolution if possible"
  },
  {
    "flags": "--verify-signatures",
    "description": "verify that the named commit has a valid GPG signature"
  },
  {
    "flags": "-s, --strategy <strategy>",
    "description": "merge strategy to use"
  },
  {
    "flags": "-X, --strategy-option <option=value>",
    "description": "option for selected merge strategy"
  },
  {
    "flags": "-m, --message <message>",
    "description": "merge commit message (for a non-fast-forward merge)"
  },
  {
    "flags": "-F, --file <path>",
    "description": "read message from file"
  },
  {
    "flags": "--into-name <name>",
    "description": "use <name> instead of the real target"
  },
  {
    "flags": "-v, --verbose",
    "description": "be more verbose"
  },
  {
    "flags": "-q, --quiet",
    "description": "be more quiet"
  },
  {
    "flags": "--abort",
    "description": "abort the current in-progress merge"
  },
  {
    "flags": "--quit",
    "description": "--abort but leave index and working tree alone"
  },
  {
    "flags": "--continue",
    "description": "continue the current in-progress merge"
  },
  {
    "flags": "--allow-unrelated-histories",
    "description": "allow merging unrelated histories"
  },
  {
    "flags": "--progress",
    "description": "force progress reporting"
  },
  {
    "flags": "-S, --gpg-sign[=<key-id>]",
    "description": "GPG sign commit"
  },
  {
    "flags": "--autostash",
    "description": "automatically stash/stash pop before and after"
  },
  {
    "flags": "--overwrite-ignore",
    "description": "update ignored files (default)"
  },
  {
    "flags": "--signoff",
    "description": "add a Signed-off-by trailer"
  },
  {
    "flags": "--no-verify",
    "description": "bypass pre-merge-commit and commit-msg hooks"
  }
