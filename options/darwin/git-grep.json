  },
  {
    "flags": "-e <pattern>",
    "description": "match <pattern>"
  },
  {
    "flags": "--and",
    "description": "combine patterns specified with -e"
  },
  {
    "flags": "--or",
    "description": ""
  },
  {
    "flags": "--not",
    "description": ""
  },
  {
    "flags": "-q, --quiet",
    "description": "indicate hit with exit status without output"
  },
  {
    "flags": "--all-match",
