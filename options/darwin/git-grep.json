  {
    "flags": "-h",
    "description": "don't show filenames"
  },
  {
    "flags": "-H",
    "description": "show filenames"
  },
  {
    "flags": "--full-name",
    "description": "show filenames relative to top directory"
  },
  {
    "flags": "-l, --files-with-matches",
    "description": "show only filenames instead of matching lines"
  },
  {
    "flags": "--name-only",
    "description": "synonym for --files-with-matches"
  },
  {
    "flags": "-L, --files-without-match",
    "description": "show only the names of files without match"
