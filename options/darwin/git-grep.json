  },
  {
    "flags": "--color[=<when>]",
    "description": "highlight matches"
  },
  {
    "flags": "--break",
    "description": "print empty line between matches from different files"
  },
  {
    "flags": "--heading",
    "description": "show filename only once above matches from same file"
  },
  {
    "flags": "-C, --context <n>",
    "description": "show <n> context lines before and after matches"
  },
  {
    "flags": "-B, --before-context <n>",
    "description": "show <n> context lines before matches"
  },
  {
    "flags": "-A, --after-context <n>",
