  },
  {
    "flags": "-i, --ignore-case",
    "description": "case insensitive matching"
  },
  {
    "flags": "-w, --word-regexp",
    "description": "match patterns only at word boundaries"
  },
  {
    "flags": "-a, --text",
    "description": "process binary files as text"
  },
  {
    "flags": "-I",
    "description": "don't match patterns in binary files"
