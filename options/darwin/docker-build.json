  },
  {
    "flags": "--allow stringArray",
    "description": "Allow extra privileged entitlement (e.g., \"network.host\", \"security.insecure\", \"device\", \"buildx.local.delete\")"
  },
  {
    "flags": "--annotation stringArray",
    "description": "Add annotation to the image"
  },
  {
    "flags": "--attest stringArray",
    "description": "Attestation parameters (format: \"type=sbom,generator=image\")"
  },
  {
    "flags": "--build-arg stringArray",
