  },
  {
    "flags": "--ssh stringArray",
    "description": "SSH agent socket or keys to expose to the build (format: \"default|<id>[=<socket>|<key>[,<key>]]\")"
  },
  {
    "flags": "-t, --tag stringArray",
    "description": "Image identifier (format: \"[registry/]repository[:tag]\")"
  },
  {
    "flags": "--target string",
