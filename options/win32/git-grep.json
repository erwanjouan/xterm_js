  },
  {
    "flags": "-z, --[no-]null",
    "description": "print NUL after filenames"
  },
  {
    "flags": "-o, --[no-]only-matching",
    "description": "show only matching parts of a line"
  },
  {
    "flags": "-c, --[no-]count",
    "description": "show the number of matches instead of matching lines"
  },
  {
    "flags": "--[no-]color[=<when>] highlight matches",
    "description": ""
  },
  {
    "flags": "--[no-]break",
    "description": "print empty line between matches from different files"
  },
  {
    "flags": "--[no-]heading",
    "description": "show filename only once above matches from same file"
  },
  {
    "flags": "-C, --[no-]context <n>",
