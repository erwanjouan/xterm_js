[
  {
    "flags": "--[no-]cached",
    "description": "search in index instead of in the work tree"
  },
  {
    "flags": "--no-index",
    "description": "find in contents not managed by git"
  },
  {
    "flags": "--index",
    "description": "opposite of --no-index"
  },
  {
    "flags": "--[no-]untracked",
    "description": "search in both tracked and untracked files"
  },
  {
    "flags": "--[no-]exclude-standard",
    "description": "ignore files specified via '.gitignore'"
  },
  {
    "flags": "--[no-]recurse-submodules",
    "description": "recursively search in each submodule"
  },
  {
    "flags": "-v, --[no-]invert-match",
    "description": "show non-matching lines"
  },
  {
    "flags": "-i, --[no-]ignore-case",
    "description": "case insensitive matching"
  },
  {
    "flags": "-w, --[no-]word-regexp",
