[
  {
    "flags": "To see every process on the system using BSD syntax:",
    "description": "ps ax\nps axu"
  },
  {
    "flags": "To print a process tree:",
    "description": "ps -ejH\nps axjf"
  },
  {
    "flags": "To get info about threads:",
    "description": "ps -eLf\nps axms"
  },
  {
    "flags": "To get security info:",
    "description": "ps -eo euser,ruser,suser,fuser,f,comm,label\nps axZ\nps -eM"
  },
  {
    "flags": "To see every process running as root (real & effective ID) in user format:",
    "description": "ps -U root -u root u"
  },
  {
    "flags": "To see every process with a user-defined format:",
    "description": "ps -eo pid,tid,class,rtprio,ni,pri,psr,pcpu,stat,wchan:14,comm\nps axo stat,euid,ruid,tty,tpgid,sess,pgrp,ppid,pid,pcpu,comm\nps -eopid,tt,user,fname,tmout,f,wchan"
  },
  {
    "flags": "Print only the process IDs of syslogd:",
    "description": "ps -C syslogd -o pid="
  },
  {
    "flags": "Print only the name of PID 42:",
    "description": "ps -p 42 -o comm="
  },
