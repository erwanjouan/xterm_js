{
  "name": "xterm-node",
  "version": "1.0.0",
  "scripts": {
    "build:server": "tsc",
    "build:client": "esbuild src/client.ts --bundle --outfile=public/client.js",
    "build": "npm run build:server && npm run build:client",
    "dev": "concurrently \"ts-node src/server.ts\" \"esbuild src/client.ts --bundle --outfile=public/client.js --watch\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.18.2",
    "js-yaml": "^5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
